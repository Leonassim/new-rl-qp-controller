+/*! force_gain.dat: one line per force sensor id, "<force gain> <torque gain>".
+ *  Missing file or missing lines mean gain 1.0. */
+void TransListenerImpl::loadForceGain(){
+	m_forceGain.assign(2*4, 1.0);
+	std::string path = IOB_SHARE_DIR;
+	path.append("/force_gain.dat");
+	std::ifstream s(path.c_str());
+	if (!s.is_open()){
+		return;
+	}
+	for (unsigned int i=0; i<m_forceGain.size(); i++){
+		double g;
+		if (!(s >> g)) break;
+		m_forceGain[i] = g;
+	}
+	for (unsigned int i=0; i<m_forceGain.size()/2; i++){
+		std::cout << "force sensor " << i << " gain: force " << m_forceGain[2*i]
+			  << " torque " << m_forceGain[2*i+1] << std::endl;
+	}
+}
